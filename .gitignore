# Allowlist pattern: ignore everything, then include orchestration files
*

# Orchestration files
!.gitignore
!README.md
!CLAUDE.md
!CLAUDE.local.md.example
!repos.list.example
# repos.list and CLAUDE.local.md stay untracked: they are machine/team specific

# Task scripts and shared library
!.bin/
!.bin/**

.bin/**/__pycache__/
.bin/**/.pytest_cache/
# tempo-log per-machine config and state
.tempo-log.toml
.tempo-log/
.venv-tempo-log/
!.tempo-log.toml.example
!pytest.ini

# Global-layer templates (~/.claude seeding)
!global/
!global/**

# Example reference project (tracked; its build artifacts are not)
!examples/
!examples/**
examples/**/.venv-gate/
examples/**/__pycache__/
examples/**/.pytest_cache/
examples/**/.ruff_cache/
examples/**/*.egg-info/

# Task manifests
!.tasks/
!.tasks/**
.tasks/*.yaml

# Claude Code config
!.claude/
!.claude/**
.claude/settings.local.json

# Documentation hub (own git repo — excluded to avoid embedded repo)
# docs/

# Ephemeral / generated — always exclude
.worktrees/
.playwright-mcp/
.vscode/

.docs/